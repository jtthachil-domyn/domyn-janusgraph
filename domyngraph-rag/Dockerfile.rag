FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir uv && uv pip install --system -r pyproject.toml 2>/dev/null || pip install --no-cache-dir fastapi uvicorn gremlinpython httpx pydantic chromadb sentence-transformers rank-bm25 pandas toml openai numpy

COPY packages/ packages/
COPY services/rag/ services/rag/

RUN mkdir -p data/chroma data/bm25 data/graph_rag_output

EXPOSE 8083
CMD ["python", "-m", "uvicorn", "services.rag.main:app", "--host", "0.0.0.0", "--port", "8083"]
