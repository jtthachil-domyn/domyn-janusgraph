# ── Schema ────────────────────────────────────────────────────────
ENTITY_SCHEMA=Entity, Chunk, Document, Concept
RELATIONSHIP_SCHEMA=RELATION, CONTAINS, REFERENCES, SIMILAR_TO

# ── Domain ────────────────────────────────────────────────────────
DOMAIN_DESCRIPTION=knowledge graphs and document analysis
DOMAIN_INFO=structured information
DOCUMENT_TYPE=documents

# ── Retrieval Settings ────────────────────────────────────────────
N_TRIPLETS=10
N_CHUNKS=5
BM25_WEIGHT=0.75
MAX_CONTEXT_LENGTH=14000

# ── Processing ────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
UPLOAD_DIR=./data/uploads
KG_OUTPUT_DIR=./data/kg_output

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
