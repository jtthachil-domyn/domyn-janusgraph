EMBEDDING_API_KEY=sk-v10TyzbmfF6Kf7KvjgrLNg

# ── JanusGraph (Gremlin) ─────────────────────────────────────────
GREMLIN_URL=ws://localhost:8182/gremlin
GRAPH_ALIAS=graph
DEFAULT_TENANT=default

# ── ChromaDB / BM25 ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
BM25_PERSIST_DIR=./data/bm25
CHUNK_COLLECTION=domyngraph_chunks
TRIPLET_COLLECTION=domyngraph_triplets

# ── Graph RAG ─────────────────────────────────────────────────────
GRAPH_RAG_OUTPUT_DIR=./data/graph_rag_output
